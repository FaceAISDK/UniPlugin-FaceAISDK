<template>
  <view class="page">
    <view
      v-if="cameraPermissionGranted"
      class="capture-layout"
      :class="useWideLayout ? 'capture-layout-landscape' : 'capture-layout-portrait'"
    >
      <view class="preview-panel">
        <view class="native-view-hint">
          <text class="native-view-hint-text">{{ captureTipText }}</text>
        </view>

        <view class="native-view-frame">
          <face-ai-capture-compat
            ref="captureCompatRef"
            class="capture-view"
            :performanceMode="1"
            :needLivenessCheck="true"
            :cameraId="0"
            :linearZoom="0.12"
            :rotationDegrees="-1"
            :showFaceCover="false"
            :autoStart="false"
            @ready="onCaptureReady"
            @result="onCaptureResult"
            @tips="onCaptureTips"
            @error="onCaptureError"
            @camera-change="onCameraChange"
          />
        </view>
      </view>

      <view
        class="status-panel"
        :class="useWideLayout ? 'status-panel-landscape' : 'status-panel-portrait'"
      >
        <text class="status-text">{{ statusText }}</text>
        <text class="status-text">抓拍次数：{{ captureCount }}</text>
        <text class="status-text">静默活体分数：{{ silentScore }}</text>
        <text class="status-text">当前相机：{{ currentCameraId == 0 ? '前置' : '后置' }}</text>
        <view class="control-row">
          <button
            class="control-button control-button-primary"
            :disabled="!captureReady || captureInProgress"
            @tap="startOrRetryCapture"
          >{{ captureButtonText }}</button>
          <button
            class="control-button control-button-secondary"
            :disabled="!captureReady || !captureStarted"
            @tap="toggleCamera"
          >切换前后相机</button>
        </view>
      </view>
    </view>

    <view v-else class="permission-panel">
      <text class="permission-title">{{ permissionTitleText }}</text>
      <text class="permission-description">{{ permissionDescriptionText }}</text>
      <button
        v-if="permissionPermanentlyDenied"
        class="action-button"
        :disabled="permissionRequesting"
        @tap="openPermissionSettings"
      >打开系统设置</button>
      <button
        v-else
        class="action-button"
        :loading="permissionRequesting"
        :disabled="permissionRequesting"
        @tap="requestCameraPermission"
      >{{ permissionActionText }}</button>
      <text class="permission-status">{{ statusText }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { FaceAiCaptureCompatElement } from "uts.sdk.modules.FaceAISearch"

const CAMERA_PERMISSIONS: Array<string> = ["android.permission.CAMERA"]
const CAMERA_PERMISSION_REQUESTED_KEY = "face_ai_camera_permission_requested"
const CAMERA_PERMISSION_PERMANENTLY_DENIED_KEY = "face_ai_camera_permission_permanently_denied"
const captureCompatRef = ref<FaceAiCaptureCompatElement | null>(null)
const cameraPermissionGranted = ref(false)
const permissionPermanentlyDenied = ref(readStoredBoolean(CAMERA_PERMISSION_PERMANENTLY_DENIED_KEY))
const permissionRequesting = ref(false)
const permissionActivityAvailable = ref(true)
const permissionTitleText = ref("正在检查相机权限")
const permissionDescriptionText = ref("相机仅用于本地人脸抓拍，图像不会上传。")
const permissionActionText = ref("授权相机")
const captureCount = ref(0)
const silentScore = ref(0.0)
const statusText = ref("正在检查相机权限…")
const captureTipText = ref("请摆正头部并将人脸置于取景框内")
const useWideLayout = ref(false)
const captureReady = ref(false)
const captureStarted = ref(false)
const captureInProgress = ref(false)
const captureButtonText = ref("开始抓拍")
const currentCameraId = ref(0)
let pageReady = false
let pageActive = true
let returningFromPermissionSettings = false

function readStoredBoolean(key: string): boolean {
  const value = uni.getStorageSync(key)
  return value != null && (value as boolean)
}

function resetCaptureSessionState() {
  captureReady.value = false
  captureStarted.value = false
  captureInProgress.value = false
  captureButtonText.value = "开始抓拍"
  currentCameraId.value = 0
}

function applyCameraPermissionGranted() {
  const permissionChanged = !cameraPermissionGranted.value
  cameraPermissionGranted.value = true
  permissionRequesting.value = false
  permissionActivityAvailable.value = true
  permissionPermanentlyDenied.value = false
  uni.removeStorageSync(CAMERA_PERMISSION_PERMANENTLY_DENIED_KEY)
  if (permissionChanged) {
    resetCaptureSessionState()
  }
  if (!captureReady.value) {
    statusText.value = "相机权限已授予，正在加载兼容模式组件…"
  }
}

function applyCameraPermissionDenied(permanentlyDenied: boolean, message: string) {
  cameraPermissionGranted.value = false
  permissionRequesting.value = false
  permissionActivityAvailable.value = true
  permissionPermanentlyDenied.value = permanentlyDenied
  resetCaptureSessionState()

  if (permanentlyDenied) {
    uni.setStorageSync(CAMERA_PERMISSION_PERMANENTLY_DENIED_KEY, true)
    permissionTitleText.value = "请在系统设置中开启相机权限"
    permissionDescriptionText.value = "相机权限已被禁止再次询问。开启后返回本页，页面会自动重新检查。"
  } else {
    uni.removeStorageSync(CAMERA_PERMISSION_PERMANENTLY_DENIED_KEY)
    permissionTitleText.value = "需要相机权限"
    permissionDescriptionText.value = "相机仅用于本地人脸抓拍，图像不会上传。授权后由你手动开始抓拍。"
  }
  permissionActionText.value = "授权相机"
  statusText.value = message
}

function applyPermissionActivityUnavailable() {
  permissionRequesting.value = false
  permissionActivityAvailable.value = false
  permissionTitleText.value = "暂时无法检查相机权限"
  permissionDescriptionText.value = "当前页面尚未连接 Android Activity，请稍后重试。"
  permissionActionText.value = "重新检查"
  statusText.value = "无法获取当前 Android Activity"
}

function updateLayout(width: number, height: number) {
  useWideLayout.value = width > height && width >= 600
}

function mapString(values: Map<string, any>, key: string): string {
  const value = values.get(key)
  return value == null ? "" : (value as string)
}

function mapNumber(values: Map<string, any>, key: string): number {
  const value = values.get(key)
  return value == null ? 0 : (value as number)
}

function onCaptureReady() {
  captureReady.value = true
  captureStarted.value = false
  captureInProgress.value = false
  captureButtonText.value = "开始抓拍"
  currentCameraId.value = 0
  statusText.value = "兼容模式组件已就绪，点击“开始抓拍”"
  captureTipText.value = "点击按钮后请摆正头部并将人脸置于取景框内"
}

function onCaptureResult(result: Map<string, any>) {
  const croppedBase64 = mapString(result, "croppedBase64")
  const originBase64 = mapString(result, "originBase64")
  captureCount.value++
  silentScore.value = mapNumber(result, "silentScore")
  captureInProgress.value = false
  captureButtonText.value = "再次抓拍"
  captureTipText.value = "已暂停检测，点击“再次抓拍”调用 retry()"
  statusText.value = `单次抓拍成功，裁剪图 ${croppedBase64.length} 字符，原图 ${originBase64.length} 字符`
}

function onCaptureTips(tips: Map<string, any>) {
  const message = mapString(tips, "message")
  captureTipText.value = message
  statusText.value = `提示 ${mapNumber(tips, "code")}：${message}`
}

function onCaptureError(error: Map<string, any>) {
  const code = mapString(error, "code")
  const message = mapString(error, "message")
  if (code == "CAMERA_PERMISSION_REQUIRED") {
    captureTipText.value = message
    applyCameraPermissionDenied(false, "相机权限已失效，请重新授权")
    return
  }

  captureTipText.value = message
  statusText.value = `错误 ${code}：${message}`
  if (code != "CAMERA_NOT_AVAILABLE" && code != "CAMERA_SWITCH_FAILED") {
    captureInProgress.value = false
    if (code == "BITMAP_ENCODE_FAILED") {
      captureButtonText.value = "再次抓拍"
    } else {
      captureStarted.value = false
      captureButtonText.value = "重新开始"
    }
  }
}

function onCameraChange(result: Map<string, any>) {
  const cameraId = mapNumber(result, "cameraId")
  currentCameraId.value = cameraId
  statusText.value = `已切换到${cameraId == 0 ? '前置' : '后置'}相机`
}

function startOrRetryCapture() {
  const component = captureCompatRef.value
  if (component == null || !captureReady.value || captureInProgress.value) return

  if (captureStarted.value) {
    component.retry()
    statusText.value = "已调用 retry()，正在等待下一帧…"
  } else {
    component.start()
    captureStarted.value = true
    statusText.value = "已调用 start()，正在等待第一帧…"
  }
  captureInProgress.value = true
  captureButtonText.value = "抓拍中…"
  captureTipText.value = "请摆正头部并将人脸置于取景框内"
}

function toggleCamera() {
  const component = captureCompatRef.value
  if (component == null || !captureReady.value || !captureStarted.value) return
  component.toggleCamera()
  statusText.value = "正在切换前后相机…"
}

function refreshCameraPermission(): boolean {
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) {
    applyPermissionActivityUnavailable()
    return cameraPermissionGranted.value
  }

  permissionActivityAvailable.value = true
  const granted = UTSAndroid.checkSystemPermissionGranted(
    activity,
    CAMERA_PERMISSIONS
  )
  if (granted) {
    applyCameraPermissionGranted()
  } else {
    applyCameraPermissionDenied(
      permissionPermanentlyDenied.value,
      permissionPermanentlyDenied.value
        ? "相机权限仍未开启"
        : "需要授予相机权限才能使用抓拍组件"
    )
  }
  return granted
}

function requestCameraPermission() {
  if (permissionRequesting.value) return

  const activity = UTSAndroid.getUniActivity()
  if (activity == null) {
    applyPermissionActivityUnavailable()
    return
  }

  permissionActivityAvailable.value = true
  if (UTSAndroid.checkSystemPermissionGranted(activity, CAMERA_PERMISSIONS)) {
    applyCameraPermissionGranted()
    return
  }

  permissionRequesting.value = true
  permissionTitleText.value = "正在申请相机权限"
  permissionDescriptionText.value = "请在系统弹窗中允许相机权限。"
  permissionActionText.value = "正在申请…"
  statusText.value = "等待相机权限授权结果…"
  uni.setStorageSync(CAMERA_PERMISSION_REQUESTED_KEY, true)

  UTSAndroid.requestSystemPermission(
    activity,
    CAMERA_PERMISSIONS,
    (allRight: boolean, _grantedList: Array<string>) => {
      if (!pageActive) return
      const currentActivity = UTSAndroid.getUniActivity()
      const granted = currentActivity != null && UTSAndroid.checkSystemPermissionGranted(
        currentActivity,
        CAMERA_PERMISSIONS
      )
      if (allRight && granted) {
        applyCameraPermissionGranted()
      } else {
        applyCameraPermissionDenied(false, "相机权限未授予，点击按钮可重新申请")
      }
    },
    (doNotAskAgain: boolean, _grantedList: Array<string>) => {
      if (!pageActive) return
      const currentActivity = UTSAndroid.getUniActivity()
      if (
        currentActivity != null &&
        UTSAndroid.checkSystemPermissionGranted(currentActivity, CAMERA_PERMISSIONS)
      ) {
        applyCameraPermissionGranted()
        return
      }
      applyCameraPermissionDenied(
        doNotAskAgain,
        doNotAskAgain
          ? "相机权限已被禁止再次询问，请前往系统设置开启"
          : "相机权限被拒绝，点击按钮可重新申请"
      )
    }
  )
}

function openPermissionSettings() {
  if (permissionRequesting.value) return
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) {
    applyPermissionActivityUnavailable()
    return
  }
  returningFromPermissionSettings = true
  statusText.value = "已打开系统设置，请允许相机权限后返回"
  UTSAndroid.gotoSystemPermissionActivity(activity, CAMERA_PERMISSIONS)
}

onReady(() => {
  pageReady = true
  const windowInfo = uni.getWindowInfo()
  updateLayout(windowInfo.windowWidth, windowInfo.windowHeight)
  const granted = refreshCameraPermission()
  const requestedBefore = readStoredBoolean(CAMERA_PERMISSION_REQUESTED_KEY)
  if (!granted && permissionActivityAvailable.value && !requestedBefore && !permissionPermanentlyDenied.value) {
    requestCameraPermission()
  }
})

onShow(() => {
  if (!pageReady || permissionRequesting.value) return
  const returnedFromSettings = returningFromPermissionSettings
  returningFromPermissionSettings = false
  const granted = refreshCameraPermission()
  if (returnedFromSettings && !granted && permissionActivityAvailable.value) {
    applyCameraPermissionDenied(true, "系统设置中仍未开启相机权限")
  }
})

onUnload(() => {
  pageActive = false
  permissionRequesting.value = false
})

onResize((options: OnResizeOptions) => {
  updateLayout(options.size.windowWidth, options.size.windowHeight)
})
</script>

<style>
.page {
  flex: 1;
  background-color: #1677ff;
}

.capture-layout {
  flex: 1;
  min-width: 0;
  min-height: 0;
}

.capture-layout-portrait {
  flex-direction: column;
}

.capture-layout-landscape {
  flex-direction: row;
}

.preview-panel {
  flex: 1;
  min-width: 0;
  min-height: 0;
}

.native-view-hint {
  width: 100%;
  box-sizing: border-box;
  padding: 8px 12px;
  background-color: #1677ff;
}

.native-view-hint-text {
  color: #ffffff;
  font-size: 17px;
  line-height: 22px;
  text-align: center;
}

.native-view-frame {
  flex: 1;
  min-height: 0;
  margin-top: 8px;
  margin-right: 20px;
  margin-bottom: 12px;
  margin-left: 20px;
  overflow: hidden;
  transform: scale(0.8);
}

.capture-view {
  width: 100%;
  height: 100%;
  background-color: #000000;
}

.permission-panel {
  flex: 1;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background-color: #1677ff;
}

.permission-title {
  color: #ffffff;
  font-size: 18px;
  font-weight: bold;
}

.permission-description {
  margin-top: 12px;
  color: #cccccc;
  font-size: 14px;
  text-align: center;
}

.action-button {
  margin-top: 20px;
  color: #ffffff;
  background-color: #136918;
}

.permission-status {
  margin-top: 12px;
  color: #ffffff;
  font-size: 12px;
  text-align: center;
}

.status-panel {
  box-sizing: border-box;
  padding: 10px 12px;
  background-color: #1677ff;
}

.status-panel-portrait {
  flex-shrink: 0;
}

.status-panel-landscape {
  width: 280px;
  flex-shrink: 0;
  justify-content: center;
  border-left-width: 1px;
  border-left-style: solid;
  border-left-color: #4b95ff;
  padding-right: 20px;
  padding-left: 20px;
}

.status-text {
  color: #ffffff;
  font-size: 14.4px;
  line-height: 21.6px;
}

.control-row {
  flex-direction: row;
  margin-top: 12px;
}

.control-button {
  flex: 1;
  height: 40px;
  margin: 0;
  padding: 0 8px;
  color: #ffffff;
  font-size: 13px;
  line-height: 40px;
}

.control-button-primary {
  background-color: #136918;
}

.control-button-secondary {
  margin-left: 8px;
  background-color: #465362;
}
</style>
