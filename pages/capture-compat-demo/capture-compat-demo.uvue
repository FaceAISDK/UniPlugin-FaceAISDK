<template>
  <view class="page">
    <view
      v-if="cameraPermissionGranted"
      class="capture-layout"
      :class="useWideLayout ? 'capture-layout-landscape' : 'capture-layout-portrait'"
    >
      <view class="preview-panel">
        <view class="native-view-hint">
          <text class="native-view-hint-text">{{ captureTipText }}</text>
        </view>

        <view class="native-view-frame">
          <face-ai-capture-compat
            ref="captureCompatRef"
            class="capture-view"
            :performanceMode="1"
            :needLivenessCheck="true"
            :cameraId="0"
            :linearZoom="0.12"
            :rotationDegrees="-1"
            :cameraSizeHigh="false"
            :showFaceCover="false"
            :autoStart="false"
            @ready="onCaptureReady"
            @result="onCaptureResult"
            @tips="onCaptureTips"
            @error="onCaptureError"
            @camera-change="onCameraChange"
          />
        </view>
      </view>

      <view
        class="status-panel"
        :class="useWideLayout ? 'status-panel-landscape' : 'status-panel-portrait'"
      >
        <text class="status-text">{{ statusText }}</text>
        <text class="status-text">抓拍次数：{{ captureCount }}</text>
        <text class="status-text">静默活体分数：{{ silentScore }}</text>
        <text class="status-text">当前相机：{{ currentCameraId == 0 ? '前置' : '后置' }}</text>
        <view class="control-row">
          <button
            class="control-button control-button-primary"
            :disabled="!captureReady || captureInProgress"
            @tap="startOrRetryCapture"
          >{{ captureButtonText }}</button>
          <button
            class="control-button control-button-secondary"
            :disabled="!captureReady || !captureStarted"
            @tap="toggleCamera"
          >切换前后相机</button>
        </view>
      </view>
    </view>

    <view v-else class="permission-panel">
      <text class="permission-title">需要相机权限</text>
      <text class="permission-description">授权后可在当前页面手动启动兼容模式人脸抓拍组件。</text>
      <button v-if="permissionPermanentlyDenied" class="action-button" @tap="openPermissionSettings">打开权限设置</button>
      <button v-else class="action-button" @tap="requestCameraPermission">授权并开始</button>
      <text class="permission-status">{{ statusText }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { FaceAiCaptureCompatElement } from "uts.sdk.modules.FaceAISearch"

const CAMERA_PERMISSIONS: Array<string> = ["android.permission.CAMERA"]
const captureCompatRef = ref<FaceAiCaptureCompatElement | null>(null)
const cameraPermissionGranted = ref(false)
const permissionPermanentlyDenied = ref(false)
const captureCount = ref(0)
const silentScore = ref(0.0)
const statusText = ref("正在检查相机权限…")
const captureTipText = ref("请摆正头部并将人脸置于取景框内")
const useWideLayout = ref(false)
const captureReady = ref(false)
const captureStarted = ref(false)
const captureInProgress = ref(false)
const captureButtonText = ref("开始抓拍")
const currentCameraId = ref(0)

function updateLayout(width: number, height: number) {
  useWideLayout.value = width > height && width >= 600
}

function mapString(values: Map<string, any>, key: string): string {
  const value = values.get(key)
  return value == null ? "" : (value as string)
}

function mapNumber(values: Map<string, any>, key: string): number {
  const value = values.get(key)
  return value == null ? 0 : (value as number)
}

function onCaptureReady() {
  captureReady.value = true
  captureStarted.value = false
  captureInProgress.value = false
  captureButtonText.value = "开始抓拍"
  currentCameraId.value = 0
  statusText.value = "兼容模式组件已就绪，点击“开始抓拍”"
  captureTipText.value = "点击按钮后请摆正头部并将人脸置于取景框内"
}

function onCaptureResult(result: Map<string, any>) {
  const croppedBase64 = mapString(result, "croppedBase64")
  const originBase64 = mapString(result, "originBase64")
  captureCount.value++
  silentScore.value = mapNumber(result, "silentScore")
  captureInProgress.value = false
  captureButtonText.value = "再次抓拍"
  captureTipText.value = "已暂停检测，点击“再次抓拍”调用 retry()"
  statusText.value = `单次抓拍成功，裁剪图 ${croppedBase64.length} 字符，原图 ${originBase64.length} 字符`
}

function onCaptureTips(tips: Map<string, any>) {
  const message = mapString(tips, "message")
  captureTipText.value = message
  statusText.value = `提示 ${mapNumber(tips, "code")}：${message}`
}

function onCaptureError(error: Map<string, any>) {
  const code = mapString(error, "code")
  const message = mapString(error, "message")
  captureTipText.value = message
  statusText.value = `错误 ${code}：${message}`
  if (code != "CAMERA_NOT_AVAILABLE" && code != "CAMERA_SWITCH_FAILED") {
    captureInProgress.value = false
    if (code == "BITMAP_ENCODE_FAILED") {
      captureButtonText.value = "再次抓拍"
    } else {
      captureStarted.value = false
      captureButtonText.value = "重新开始"
    }
  }
  if (code == "CAMERA_PERMISSION_REQUIRED") {
    cameraPermissionGranted.value = false
    captureReady.value = false
    captureStarted.value = false
  }
}

function onCameraChange(result: Map<string, any>) {
  const cameraId = mapNumber(result, "cameraId")
  currentCameraId.value = cameraId
  statusText.value = `已切换到${cameraId == 0 ? '前置' : '后置'}相机`
}

function startOrRetryCapture() {
  const component = captureCompatRef.value
  if (component == null || !captureReady.value || captureInProgress.value) return

  if (captureStarted.value) {
    component.retry()
    statusText.value = "已调用 retry()，正在等待下一帧…"
  } else {
    component.start()
    captureStarted.value = true
    statusText.value = "已调用 start()，正在等待第一帧…"
  }
  captureInProgress.value = true
  captureButtonText.value = "抓拍中…"
  captureTipText.value = "请摆正头部并将人脸置于取景框内"
}

function toggleCamera() {
  const component = captureCompatRef.value
  if (component == null || !captureReady.value || !captureStarted.value) return
  component.toggleCamera()
  statusText.value = "正在切换前后相机…"
}

function refreshCameraPermission() {
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) {
    statusText.value = "无法获取当前 Android Activity"
    return
  }

  cameraPermissionGranted.value = UTSAndroid.checkSystemPermissionGranted(
    activity,
    CAMERA_PERMISSIONS
  )
  if (cameraPermissionGranted.value) {
    permissionPermanentlyDenied.value = false
    statusText.value = "相机权限已授予，正在启动组件…"
  }
}

function requestCameraPermission() {
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) {
    statusText.value = "无法获取当前 Android Activity"
    return
  }

  UTSAndroid.requestSystemPermission(
    activity,
    CAMERA_PERMISSIONS,
    (allRight: boolean, _grantedList: Array<string>) => {
      cameraPermissionGranted.value = allRight
      if (allRight) {
        permissionPermanentlyDenied.value = false
        statusText.value = "相机权限已授予，正在启动组件…"
      } else {
        statusText.value = "相机权限未完全授予"
      }
    },
    (doNotAskAgain: boolean, _grantedList: Array<string>) => {
      cameraPermissionGranted.value = false
      permissionPermanentlyDenied.value = doNotAskAgain
      statusText.value = doNotAskAgain
        ? "相机权限已被永久拒绝，请前往系统设置开启"
        : "相机权限被拒绝"
    }
  )
}

function openPermissionSettings() {
  const activity = UTSAndroid.getUniActivity()
  if (activity != null) {
    UTSAndroid.gotoSystemPermissionActivity(activity, CAMERA_PERMISSIONS)
  }
}

onReady(() => {
  const windowInfo = uni.getWindowInfo()
  updateLayout(windowInfo.windowWidth, windowInfo.windowHeight)
  refreshCameraPermission()
  if (!cameraPermissionGranted.value) {
    requestCameraPermission()
  }
})

onShow(() => {
  refreshCameraPermission()
})

onResize((options: OnResizeOptions) => {
  updateLayout(options.size.windowWidth, options.size.windowHeight)
})
</script>

<style>
.page {
  flex: 1;
  background-color: #1677ff;
}

.capture-layout {
  flex: 1;
  min-width: 0;
  min-height: 0;
}

.capture-layout-portrait {
  flex-direction: column;
}

.capture-layout-landscape {
  flex-direction: row;
}

.preview-panel {
  flex: 1;
  min-width: 0;
  min-height: 0;
}

.native-view-hint {
  width: 100%;
  box-sizing: border-box;
  padding: 8px 12px;
  background-color: #1677ff;
}

.native-view-hint-text {
  color: #ffffff;
  font-size: 17px;
  line-height: 22px;
  text-align: center;
}

.native-view-frame {
  flex: 1;
  min-height: 0;
  margin-top: 8px;
  margin-right: 20px;
  margin-bottom: 12px;
  margin-left: 20px;
  overflow: hidden;
  transform: scale(0.8);
}

.capture-view {
  width: 100%;
  height: 100%;
  background-color: #000000;
}

.permission-panel {
  flex: 1;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background-color: #1677ff;
}

.permission-title {
  color: #ffffff;
  font-size: 18px;
  font-weight: bold;
}

.permission-description {
  margin-top: 12px;
  color: #cccccc;
  font-size: 14px;
  text-align: center;
}

.action-button {
  margin-top: 20px;
  color: #ffffff;
  background-color: #136918;
}

.permission-status {
  margin-top: 12px;
  color: #ffffff;
  font-size: 12px;
  text-align: center;
}

.status-panel {
  box-sizing: border-box;
  padding: 10px 12px;
  background-color: #1677ff;
}

.status-panel-portrait {
  flex-shrink: 0;
}

.status-panel-landscape {
  width: 280px;
  flex-shrink: 0;
  justify-content: center;
  border-left-width: 1px;
  border-left-style: solid;
  border-left-color: #4b95ff;
  padding-right: 20px;
  padding-left: 20px;
}

.status-text {
  color: #ffffff;
  font-size: 14.4px;
  line-height: 21.6px;
}

.control-row {
  flex-direction: row;
  margin-top: 12px;
}

.control-button {
  flex: 1;
  height: 40px;
  margin: 0;
  padding: 0 8px;
  color: #ffffff;
  font-size: 13px;
  line-height: 40px;
}

.control-button-primary {
  background-color: #136918;
}

.control-button-secondary {
  margin-left: 8px;
  background-color: #465362;
}
</style>
